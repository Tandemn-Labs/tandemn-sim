# Required when AIC reads metadata for gated Hugging Face models.
HF_TOKEN=

# Required when --method gpt_only calls the OpenAI Responses API.
OPENAI_API_KEY=

# Agentic uses the authenticated default AWS profile for Amazon Bedrock.
# Authenticate it with `aws configure` or `aws sso login --profile default`.
AWS_PROFILE=default
AWS_REGION=us-east-2
